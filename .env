# JWT Configuration
# Rotated. The previous value was hand-typed and is committed in this repo's git
# history, so it must be treated as public. Rotating invalidates every session
# token that was signed with it: all users have to sign in again once.
# Regenerate with:  openssl rand -base64 48
JWT_SECRET=dHuUzLaNcrkx7e0BOq7zdTAN2L6LnE51-AWI11rL0ww1Pdf1_t84LthDp56zt7hy

# Session cookie behaviour. The UI is served from a different site than this API
# (vercel.app -> primeosys.com), so the auth cookie must be SameSite=None and
# Secure or the browser drops it on API and WebSocket calls.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
ACCESS_TOKEN_TTL=30m

# Per-user machine authorization. Leave on. Setting this to false disables the
# check that a user may only read their own chillers.
MACHINE_SCOPE_ENFORCE=true

# Accounts that may read the WHOLE fleet (Grain Technik staff). Everyone else is
# scoped to the machines listed in their monitorAccess column.
# Defaults match the two staff accounts: usernames Narayan12,Yogendra and the
# accountType only they carry, "manufactura".
# The 8 "manufacturer" accounts are deliberately NOT included — adding them would
# give them every customer's data. Add only after confirming their role.
FLEET_ACCESS_USERNAMES=Narayan12,Yogendra
FLEET_ACCESS_ACCOUNT_TYPES=manufactura

# Accounts that may manage users and reach diagnostic endpoints. Separate from
# fleet data access above.
USER_ADMIN_USERNAMES=Narayan12,Yogendra

# Account creation stays behind an admin session.
ALLOW_PUBLIC_REGISTER=false

# Server Configuration
PORT=3000

# CORS Configuration
CORS_ORIGIN=https://new-plc-software-5xyc.vercel.app
CORS_ALLOWED_ORIGINS=https://new-plc-software-5xyc.vercel.app,http://localhost:3000,http://localhost:3001

