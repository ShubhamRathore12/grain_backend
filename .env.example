# Grain backend configuration template.
# Copy to .env and fill in real values. Never commit the filled-in file.
#
#   cp .env.example .env
#
# Every value marked REQUIRED must be set or the process refuses to start.

# --- Database -----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- JWT signing secret (REQUIRED) --------------------------------------------
# This is the single most sensitive value here: whoever holds it can mint a valid
# session token for any account and bypass both authentication and per-machine
# authorization.
#
# Generate a fresh one:
#   openssl rand -base64 48
#   # or, on Windows PowerShell:
#   # [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
#
# Rules enforced at startup (config/config.go):
#   - at least 32 characters
#   - not a known placeholder or previously leaked value
#   - must have real character variety
#
# Rotating this value invalidates every existing session; all users sign in again.
JWT_SECRET=

# Preferred in container/orchestrated deployments: point at a mounted secret file
# instead of putting the value in the environment block, where it shows up in
# `docker inspect`, crash dumps and process listings. Takes precedence over
# JWT_SECRET when set.
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# --- Session cookie -----------------------------------------------------------
# The UI is served from a different site than this API, so the browser only sends
# the auth cookie when it is SameSite=None *and* Secure. Set COOKIE_SECURE=false
# only for local plain-HTTP development, which also forces SameSite back to lax.
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# COOKIE_DOMAIN=
ACCESS_TOKEN_TTL=30m

# --- Authorization ------------------------------------------------------------
# Enforces that a user may only read the chillers listed in their monitorAccess
# grant. Leave this on. false is a break-glass switch for the rollout window and
# logs a loud warning.
MACHINE_SCOPE_ENFORCE=true

# Open account creation on a plant-control API is an access-control hole. Keep
# false; /api/register then requires an admin session.
ALLOW_PUBLIC_REGISTER=false

# Accounts that may read the WHOLE fleet (Grain Technik staff). Every other
# account is scoped to the machines listed in its monitorAccess column.
#
# These two settings are ORed: an account matching either gets fleet access.
# Keep them narrow — this is the switch that decides cross-customer data exposure.
FLEET_ACCESS_USERNAMES=Narayan12,Yogendra
FLEET_ACCESS_ACCOUNT_TYPES=manufactura

# Accounts allowed to manage users and reach diagnostic endpoints, comma
# separated. Deliberately separate from fleet data access above: "can administer
# accounts" and "can see every chiller" are different permissions.
USER_ADMIN_USERNAMES=Narayan12,Yogendra

# --- Server -------------------------------------------------------------------
PORT=3000

# --- CORS ---------------------------------------------------------------------
# Only these origins get credentialed access. "*" is accepted by the parser but
# must not be used with cookie auth.
CORS_ORIGIN=
CORS_ALLOWED_ORIGINS=

# --- Email (export delivery) --------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
